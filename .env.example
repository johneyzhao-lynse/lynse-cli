# 灵光记 / Lynse CLI 配置文件
# 复制此文件为 .env 并填入你的真实配置：cp .env.example .env

# API 服务器地址。通常配置到包含 /api 的基础地址，例如：https://api.lynse.cn
# 代码会在此基础上拼接 /api/business/... 或 /api/auth/...，不要写到 /api/business。
LYNSE_API_HOST=https://api.lynse.cn

# API Key（从系统控制台获取，格式：dk_xxx）
LYNSE_API_KEY=

# [可选] 限定只有此用户 ID 可操作，防止多人共用时越权
# LYNSE_OWNER_ID=
